{
  "name": "fundos",
  "version": "0.1.0",
  "private": true,
  "description": "FundOS — プログラマブルマネーによる自立駆動型基金オペレーティングシステム",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @fundos/core && npm run build -w @fundos/agent && npm run build -w @fundos/cli",
    "test": "npm run test -w @fundos/core && npm run test -w @fundos/agent",
    "demo": "npm run demo -w @fundos/cli",
    "agent:run": "npm run start -w @fundos/agent",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.ts",
    "lint": "tsc -b packages/core packages/agent packages/cli --pretty false"
  },
  "keywords": [
    "programmable-money",
    "autonomous-fund",
    "fundos",
    "defi",
    "policy-engine"
  ],
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "chai": "^4.5.0",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
