{
  "name": "@fundos/agent",
  "version": "0.1.0",
  "description": "Autonomous agent loop that drives FundOS funds by policy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node --import tsx src/run.ts"
  },
  "dependencies": {
    "@fundos/core": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
